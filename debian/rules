#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk

%:
	dh $@ --with python3

override_dh_auto_build:
	python3 debian/prepare-node-exporter.py --architecture "$(DEB_HOST_ARCH)" --offline

override_dh_auto_install:

override_dh_auto_clean:

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	$(MAKE) test
endif

override_dh_python3:
	dh_python3 -V 3.9- /usr/lib/spark-exporter

# Preserve the checksum-verified upstream Go binary without rewriting it.
# dwz rejects its already compressed debug sections; nondeterminism rewriting
# would also modify the redistributed upstream bytes.
override_dh_strip:
override_dh_dwz:
override_dh_strip_nondeterminism:
